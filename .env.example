# Photo-code prefetching
PHOTO_CODE_DEFAULT_BATCH_SIZE=10
PHOTO_CODE_MAX_BATCH_SIZE=100
PHOTO_CODE_VALIDITY_MONTHS=3

# JSON encryption before direct Tencent COS upload. Keep both values secret.
COS_JSON_SIGN_KEY=replace-with-a-long-random-sign-key
COS_JSON_AES_SECRET=replace-with-a-16-24-or-32-byte-aes-key

# Mobile direct-upload STS service. Whether clients use it is controlled by the
# Apollo `application` key `cos_sts_enable` (default off; the clients also
# accept the older `team_space_cos_sts_enable` key during migration).
# These credentials stay only on the server and should belong to a
# least-privilege CAM sub-account.
COS_STS_DURATION_SECONDS=900
TENCENT_COS_SECRET_ID=replace-with-server-only-secret-id
TENCENT_COS_SECRET_KEY=replace-with-server-only-secret-key
# Bucket aliases used by the clients. `validator=team` applies membership/path
# validation. Other buckets must provide at least one allowed prefix; an empty
# string allows any safe object key, while the issued permission remains exact-object.
TENCENT_COS_BUCKETS_JSON='{"team":{"bucket":"timeprint-team-1330977225","region":"ap-singapore","allowRead":true,"allowWrite":true,"validator":"team"},"ios_app":{"bucket":"timeprint-1330977225","region":"ap-singapore","allowRead":true,"allowWrite":true,"allowedPrefixes":[""]},"android_app":{"bucket":"timeprintandroid-1330977225","region":"ap-singapore","allowRead":true,"allowWrite":true,"allowedPrefixes":[""]},"watermark":{"bucket":"wm-1330977225","region":"ap-singapore","allowRead":true,"allowWrite":true,"allowedPrefixes":["wm_cover/","ugc_logo/","ugc_cover/","ugc_json/","android/"]},"ios_log":{"bucket":"tplog-1330977225","region":"ap-singapore","allowRead":false,"allowWrite":true,"allowedPrefixes":[""]},"photo_json":{"bucket":"photocode-json-1330977225","region":"ap-singapore","allowRead":false,"allowWrite":true,"validator":"photoJson"},"verify_images":{"bucket":"photocode-verify-images-1330977225","region":"ap-singapore","allowRead":false,"allowWrite":true,"validator":"verifyImage"}}'

# Photo verification orchestration. TP_OCR_CALLBACK_SECRET must match the OCR service.
TENCENT_COS_VERIFY_IMAGE_BUCKET=photocode-verify-images-1330977225
TP_OCR_BASE_URL=https://ocr.example.com
TP_OCR_API_KEY=replace-with-ocr-api-key
TP_OCR_CALLBACK_SECRET=replace-with-long-random-callback-secret

# Legacy single-team-bucket fallback. Used only when TENCENT_COS_BUCKETS_JSON
# is absent, so older deployments can roll forward without an atomic env change.
TENCENT_COS_TEAM_BUCKET=timeprint-team-1330977225
TENCENT_COS_REGION=ap-singapore
